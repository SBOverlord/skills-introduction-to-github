import win32com.client

def create_outlook_draft(subject, body, to=None, cc=None, attachments=None):
    outlook = win32com.client.Dispatch("Outlook.Application")
    mail = outlook.CreateItem(0)  # 0 = Mail item

    if to:
        mail.To = to
    if cc:
        mail.CC = cc

    mail.Subject = subject
    mail.Body = body

    if attachments:
        for file in attachments:
            mail.Attachments.Add(file)

    mail.Save()      # Saves it to Drafts
    mail.Display()   # Opens it for preview

